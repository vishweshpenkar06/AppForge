# ============================================================================
# DATABASE
# ============================================================================
# PostgreSQL connection string (use Supabase, Railway, or Neon)
# Format: postgresql://user:password@host:port/database
DATABASE_URL="postgresql://user:password@localhost:5432/appforge_dev"

# ============================================================================
# CLERK AUTHENTICATION
# ============================================================================
# Get from: https://dashboard.clerk.com/apps
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxx
CLERK_SECRET_KEY=sk_test_xxxx
CLERK_WEBHOOK_SECRET=whsec_xxxx  # For production webhook signing

# ============================================================================
# FEATHERLESS AI
# ============================================================================
# Get from: https://featherless.ai/
FEATHERLESS_API_KEY=rc_xxxx
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1

# ============================================================================
# OPTIONAL: REDIS (for BullMQ job queue)
# ============================================================================
# Only needed if using background job processing
REDIS_URL=redis://localhost:6379

# ============================================================================
# NEXT.JS ENVIRONMENT
# ============================================================================
NODE_ENV=development
# Set to production in deployed environment
