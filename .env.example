# ============================================================================
# LLM (Required — pick one provider)
# ============================================================================

# Option 1: Nvidia (recommended — free at build.nvidia.com)
NVIDIA_API_KEY=nvapi-...
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=meta/llama-3.3-70b-instruct

# Option 2: Groq (free at console.groq.com)
# GROQ_API_KEY=gsk_...
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile

# Option 3: Featherless (free at featherless.ai)
# FEATHERLESS_API_KEY=rc_...
# LLM_BASE_URL=https://api.featherless.ai/v1
# LLM_MODEL=meta-llama/Meta-Llama-3.3-70B-Instruct

# ============================================================================
# DATABASE (PostgreSQL — Supabase free tier recommended)
# ============================================================================
DATABASE_URL="postgresql://user:password@localhost:5432/appforge_dev"

# ============================================================================
# CLERK AUTHENTICATION (optional, has dev bypass)
# ============================================================================
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# ============================================================================
# PIPELINE CONFIG
# ============================================================================
DETERMINISTIC_LLM=0          # Set to 1 for offline/testing mode
MAX_REPAIR_ATTEMPTS=3        # Max LLM repair retries per stage
