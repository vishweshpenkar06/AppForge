# ============================================================================
# LLM PROVIDER (Required — pick one)
# ============================================================================

# Provider selection: nvidia | groq | featherless
# Default: nvidia (falls back to Groq on rate limit / timeout)
LLM_PROVIDER=nvidia

# --- NVIDIA NIM (recommended — free at build.nvidia.com, no credit card) ---
NVIDIA_API_KEY=nvapi-...
# Primary model: mistralai/mistral-nemotron-super-49b-v1 (default)
# Fallback model: deepseek-ai/deepseek-v4-pro (auto-selected on 429)

# --- Groq (free at console.groq.com) ---
# GROQ_API_KEY=gsk_...

# --- Featherless (free at featherless.ai) ---
# FEATHERLESS_API_KEY=rc_...

# Optional: Override the default model for the active provider
# LLM_MODEL=mistralai/mistral-nemotron-super-49b-v1

# Optional: Override the API base URL (for custom / self-hosted endpoints)
# LLM_BASE_URL=https://integrate.api.nvidia.com/v1

# ============================================================================
# DATABASE (PostgreSQL — Supabase free tier recommended)
# ============================================================================
DATABASE_URL="postgresql://user:password@localhost:5432/appforge_dev"

# ============================================================================
# CLERK AUTHENTICATION (optional, has dev bypass)
# ============================================================================
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# ============================================================================
# CLERK WEBHOOK (required for user sync via webhooks)
# ============================================================================
CLERK_WEBHOOK_SECRET=whsec_...

# ============================================================================
# PIPELINE CONFIG
# ============================================================================
DETERMINISTIC_LLM=0          # Set to 1 for offline/testing mode
MAX_REPAIR_ATTEMPTS=3        # Max LLM repair retries per stage
