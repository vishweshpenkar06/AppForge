// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum PlanTier {
  free
  pro
  team
}

model User {
  id                String    @id @default(cuid())
  clerkId           String    @unique
  email             String    @unique
  displayName       String?
  isAdmin           Boolean   @default(false)
  plan              PlanTier  @default(free)
  planStartedAt     DateTime  @default(now())
  compilesThisMonth Int       @default(0)
  compilesResetAt   DateTime  @default(now())
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  ownedTeamCode     TeamCode? @relation("TeamOwner")
  memberOfTeamId    String?
  memberOfTeam      TeamCode? @relation("TeamMembers", fields: [memberOfTeamId], references: [id])

  generations       Generation[]
  templates         Template[]
  evalRuns          EvalRun[]
  apiKeys           ApiKey[]
  webhookEndpoints  WebhookEndpoint[]

  @@map("users")
}

model TeamCode {
  id        String   @id @default(cuid())
  code      String   @unique
  ownerId   String   @unique
  owner     User     @relation("TeamOwner", fields: [ownerId], references: [id])
  seatsUsed Int      @default(1)
  maxSeats  Int      @default(5)
  createdAt DateTime @default(now())
  members   User[]   @relation("TeamMembers")

  @@map("team_codes")
}

model Generation {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  prompt          String
  mode            String   @default("balanced") // fast | balanced | precise
  status          String   @default("pending") // pending | running | success | completed | failed
  errorMessage    String?
  isFavorite      Boolean  @default(false)
  
  config          Json?
  metadata        Json?
  assumptions     Json?
  totalLatencyMs  Int?
  retryCount      Int      @default(0)
  
  createdAt       DateTime @default(now())
  completedAt     DateTime?

  pipelineStages  PipelineStage[]
  appConfig       AppConfig?
  evalResults     EvalResult[]
  templates       Template[]
  sourceTemplates Template[]

  @@index([userId])
  @@index([status])
  @@map("generations")
}

model PipelineStage {
  id              String   @id @default(cuid())
  generationId    String
  generation      Generation @relation(fields: [generationId], references: [id], onDelete: Cascade)
  
  stageName       String   // intent | design | schema | validation | repair
  stageOrder      Int
  status          String   @default("pending") // pending | running | success | failed
  
  inputTokens     Int?
  outputTokens    Int?
  latencyMs       Int?
  rawOutput       Json?
  errors          Json?
  
  createdAt       DateTime @default(now())

  @@index([generationId])
  @@map("pipeline_stages")
}

model AppConfig {
  id              String   @id @default(cuid())
  generationId    String   @unique
  generation      Generation @relation(fields: [generationId], references: [id], onDelete: Cascade)
  
  config          Json     @default("{}")
  artifacts       Json?    // generated file contents: { "path": "content", ... }
  artifactsOverride Json?  // user edits: { "path": { "content": "...", "editedAt": "..." } }
  validationPassed Boolean
  repairsApplied  Json?    // array of { field, before, after }
  schemaVersion   String   @default("1.0")
  
  createdAt       DateTime @default(now())

  @@map("app_configs")
}

model EvalRun {
  id              String   @id @default(cuid())
  userId          String?
  user            User?    @relation(fields: [userId], references: [id])
  
  name            String
  description     String?
  createdAt       DateTime @default(now())

  results         EvalResult[]

  @@map("eval_runs")
}

model EvalResult {
  id              String   @id @default(cuid())
  evalRunId       String
  evalRun         EvalRun  @relation(fields: [evalRunId], references: [id], onDelete: Cascade)
  
  generationId    String?
  generation      Generation? @relation(fields: [generationId], references: [id])
  
  promptCategory  String?  // standard | vague | conflicting | incomplete
  success         Boolean
  retryCount      Int      @default(0)
  latencyMs       Int?
  failureReason   String?
  notes           String?
  
  createdAt       DateTime @default(now())

  @@index([evalRunId])
  @@map("eval_results")
}

model CacheEntry {
  id        String   @id @default(cuid())
  cacheKey  String   @unique
  result    Json
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
  @@map("cache_entries")
}

model ApiKey {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  keyHash     String    @unique
  label       String
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@index([keyHash])
  @@map("api_keys")
}

model Template {
  id                    String   @id @default(cuid())
  authorId              String
  author                User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  title                 String
  description           String?
  sourceGenerationId    String
  sourceGeneration      Generation @relation(fields: [sourceGenerationId], references: [id], onDelete: Cascade)
  isPublic              Boolean  @default(true)
  useCount              Int      @default(0)
  createdAt             DateTime @default(now())

  @@index([authorId])
  @@index([isPublic])
  @@map("templates")
}

model WebhookEndpoint {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  url       String
  secret    String
  events    String[] // e.g. ["generation.completed", "generation.failed"]
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("webhook_endpoints")
}
